# FlowSense AI — every variable is OPTIONAL. The app runs with no .env at all (copy to .env to customise).
# No API keys are required: maps = OpenStreetMap tiles, traffic/weather = organizer dataset,
# storage = embedded DuckDB, built-in login (no auth provider), no LLM. Never commit a real .env.

# --- backend (server-side only) ---
# Where raw/processed/db data lives (default: backend/data)
DATA_DIR=
# Override the DuckDB file (default: $DATA_DIR/db/neurax.duckdb)
NEURAX_DB_PATH=
# Model artifacts, metrics, metadata (default: backend/artifacts)
MODEL_DIR=
# Comma-separated browser origins allowed to call the API (default: http://localhost:5173,http://127.0.0.1:5173)
CORS_ALLOWED_ORIGINS=
# Default simulation clock shown on first load (default: 2026-01-16 13:30:00, a held-out validation incident)
DEMO_TIME=

# --- authentication (server-side only — never prefix these with VITE_) ---
# Single demo account for the login gate (defaults: tgpolice / tgpolice). Change both for any shared deployment.
FLOWSENSE_LOGIN_ID=
FLOWSENSE_LOGIN_PASSWORD=
# Name shown in the header after sign-in (default: TG Police)
FLOWSENSE_DISPLAY_NAME=
# HMAC key for session cookies. Generate: python -c "import secrets;print(secrets.token_hex(32))"
# Unset = random per API start, so everyone is signed out whenever the API restarts.
FLOWSENSE_SESSION_SECRET=
# Session lifetime in hours (default 12)
FLOWSENSE_SESSION_TTL_HOURS=
# true when served over HTTPS (cookie gets the Secure flag); false for http://localhost
FLOWSENSE_COOKIE_SECURE=

# --- rider portal providers (server-side only; the browser never calls these) ---
# All optional. Defaults need no key: Nominatim (search), OSRM demo (routing), public Overpass (nearby places).
# auto = OpenRouteService when OPENROUTESERVICE_API_KEY is set, else OSRM. Or force: osrm | openrouteservice
ROUTING_PROVIDER=
# Optional OpenRouteService key (free tier at openrouteservice.org). Secret: never prefix with VITE_
OPENROUTESERVICE_API_KEY=
# Self-hosted or paid alternatives to the public demo servers
OSRM_URL=
OPENROUTESERVICE_URL=
GEOCODING_URL=
# Comma-separated Overpass endpoints, tried in order
OVERPASS_URL=
# Nominatim policy requires an identifying User-Agent: set your app name and contact for real use
NOMINATIM_USER_AGENT=

# --- corridor / flyover analysis (backend, optional) ---
# Traffic source: dataset = historical panel + simulation replay (the only built-in provider). A live provider plugs in via TrafficDataProvider
CORRIDOR_TRAFFIC_PROVIDER=
# Alternative weights/thresholds JSON (default: backend/app/corridor_config.json)
CORRIDOR_CONFIG_PATH=
# --- infrastructure recommendation (backend, optional) ---
# Land / infrastructure source: simulation = SIMULATED demo layer (the only built-in provider). A GIS/land provider plugs in via InfrastructureDataProvider
INFRASTRUCTURE_PROVIDER=
# Alternative effect sizes / unit costs / weights JSON (default: backend/app/infrastructure_config.json). Demo assumptions, not official figures
INFRASTRUCTURE_CONFIG_PATH=
# Environments: development uses the defaults above; tests set nothing (providers are mocked); production should point OSRM_URL /
# OPENROUTESERVICE_* at a self-hosted or paid router and set FLOWSENSE_* secrets (see the authentication section).

# --- frontend (build-time, PUBLIC — bundled into the browser; never put a secret here) ---
# Backend base URL when frontend and backend are on different hosts (default: same origin, /api proxied in dev)
VITE_API_BASE_URL=
# Basemap tile template (default: https://tile.openstreetmap.org/{z}/{x}/{y}.png — fine for demos, not heavy production use)
VITE_TILE_URL=
